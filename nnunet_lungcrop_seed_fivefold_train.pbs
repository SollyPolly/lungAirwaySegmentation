#!/bin/bash
#PBS -N nnLCSeed5F
#PBS -J 1-4
#PBS -l select=1:ncpus=6:mem=64gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /rds/general/user/dl525/home/projects/dissertation/LungAirwaySegmentation/logs/nnLCSeed5F.o^array_index^

set -euo pipefail

PROJECT=/rds/general/user/dl525/home/projects/dissertation/LungAirwaySegmentation
cd "$PROJECT"

module load miniforge/3
source "$HOME/miniforge3/etc/profile.d/conda.sh"
conda activate ctfm

export nnUNet_raw="$PROJECT/data/nnunet/nnUNet_raw"
export nnUNet_preprocessed="$PROJECT/data/nnunet/nnUNet_preprocessed"
export nnUNet_results="$PROJECT/data/nnunet/nnUNet_results"
export TORCH_HOME="$HOME/.torchcache"
export nnUNet_n_proc_DA=4

FOLD="$PBS_ARRAY_INDEX"
TRAINER=nnUNetTrainer_NoDeepSupervision_NoMirroring
RESULT_DIR="$nnUNet_results/Dataset123_ATM22L20LungCrop/${TRAINER}__nnUNetPlans__3d_fullres/fold_${FOLD}"

NNUNET_PACKAGE=$(python -c 'from pathlib import Path; import nnunetv2; print(Path(nnunetv2.__file__).resolve().parent)')
TRAINER_DIR="$NNUNET_PACKAGE/training/nnUNetTrainer/variants/network_architecture"
test -d "$TRAINER_DIR" || {
    echo "Cannot find nnU-Net trainer directory: $TRAINER_DIR"
    exit 1
}
test -f "$PROJECT/nnunet_trainers/${TRAINER}.py" || {
    echo "Missing repository trainer: $PROJECT/nnunet_trainers/${TRAINER}.py"
    exit 1
}
ln -sfn "$PROJECT/nnunet_trainers/${TRAINER}.py" "$TRAINER_DIR/${TRAINER}.py"

test -f "$nnUNet_preprocessed/Dataset123_ATM22L20LungCrop/splits_final.json" || {
    echo "Dataset123 five-fold metadata is missing; run nnunet_lungcrop_mt240_fivefold_prepare.pbs first."
    exit 1
}

python -c "
import json
from pathlib import Path
p = Path('$nnUNet_preprocessed/Dataset123_ATM22L20LungCrop/splits_final.json')
folds = json.loads(p.read_text())
assert len(folds) == 5, f'Expected five Dataset123 folds, got {len(folds)}'
assert len(folds[$FOLD]['train']) == 16 and len(folds[$FOLD]['val']) == 4
print('Dataset123 fold $FOLD split preflight OK:', folds[$FOLD]['val'])
"

if test -f "$RESULT_DIR/checkpoint_final.pth"; then
    echo "Dataset123 fold $FOLD is already complete"
    exit 0
fi

if test -f "$RESULT_DIR/checkpoint_latest.pth"; then
    nnUNetv2_train 123 3d_fullres "$FOLD" \
        -tr "$TRAINER" \
        -p nnUNetPlans \
        --c
else
    nnUNetv2_train 123 3d_fullres "$FOLD" \
        -tr "$TRAINER" \
        -p nnUNetPlans
fi

echo "Dataset123 seed fold $FOLD completed"
