#!/bin/bash
#PBS -N nnLCMT240Pred5
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /rds/general/user/dl525/home/projects/dissertation/LungAirwaySegmentation/logs/nnLCMT240Pred5.out

set -euo pipefail

PROJECT=/rds/general/user/dl525/home/projects/dissertation/LungAirwaySegmentation
cd "$PROJECT"

module load miniforge/3
source "$HOME/miniforge3/etc/profile.d/conda.sh"
conda activate ctfm

export nnUNet_raw="$PROJECT/data/nnunet/nnUNet_raw"
export nnUNet_preprocessed="$PROJECT/data/nnunet/nnUNet_preprocessed"
export nnUNet_results="$PROJECT/data/nnunet/nnUNet_results"
export TORCH_HOME="$HOME/.torchcache"

TRAINER=nnUNetTrainer_MeanTeacher_WarmStart_TwoStream_NoDeepSupervision_NoMirroring
MODEL_DIR="$nnUNet_results/Dataset126_ATM22MT240LungCrop/${TRAINER}__nnUNetPlans__3d_fullres"
CHECKPOINT="${CHECKPOINT:-checkpoint_final.pth}"
VAL_INPUT="$PROJECT/data/nnunet/predict_in/val_lungroi_m8_s120"
VAL_OUTPUT="$PROJECT/data/nnunet/predict_out/Dataset126_val_mt240_fivefold_final"

if test "$CHECKPOINT" != "checkpoint_final.pth"; then
    echo "This reportable job is frozen to checkpoint_final.pth; got CHECKPOINT=$CHECKPOINT"
    exit 1
fi

for FOLD in 0 1 2 3 4; do
    test -f "$MODEL_DIR/fold_${FOLD}/$CHECKPOINT" || {
        echo "Missing fold $FOLD checkpoint: $MODEL_DIR/fold_${FOLD}/$CHECKPOINT"
        exit 1
    }
done
test -d "$VAL_INPUT" || {
    echo "Missing external VAL lung-crop input: $VAL_INPUT"
    exit 1
}
test ! -e "$VAL_OUTPUT" || {
    echo "Refusing to merge into existing prediction directory: $VAL_OUTPUT"
    exit 1
}

nnUNetv2_predict \
    -i "$VAL_INPUT" \
    -o "$VAL_OUTPUT" \
    -d 126 \
    -c 3d_fullres \
    -f 0 1 2 3 4 \
    -p nnUNetPlans \
    -tr "$TRAINER" \
    -chk "$CHECKPOINT" \
    --disable_tta

python -u -m scripts.evaluate_nnunet_predictions \
    --pred-dir "$VAL_OUTPUT" \
    --split-config configs/nnunet/atm22_split_l20_u240.yaml \
    --report-split val \
    --branch \
    --lcc-connectivity 26 \
    --out "$VAL_OUTPUT/nnunet126_val_mt240_fivefold_final_topology_lcc26.json"

python -u -m scripts.evaluate_nnunet_predictions \
    --pred-dir "$VAL_OUTPUT" \
    --split-config configs/nnunet/atm22_split_l20_u240.yaml \
    --report-split val \
    --branch \
    --lcc-connectivity 6 \
    --skip-radius-bins \
    --out "$VAL_OUTPUT/nnunet126_val_mt240_fivefold_final_topology_lcc6.json"

echo "Dataset126 final-checkpoint five-fold external VAL prediction and scoring completed"
