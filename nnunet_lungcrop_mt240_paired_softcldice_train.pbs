#!/bin/bash
#PBS -N nnLCPairSoft
#PBS -J 1-5
#PBS -l select=1:ncpus=6:mem=64gb:ngpus=1
#PBS -l walltime=18:00:00
#PBS -j oe
#PBS -o /rds/general/user/dl525/home/projects/dissertation/LungAirwaySegmentation/logs/nnLCPairSoft.o^array_index^

set -euo pipefail
PROJECT=/rds/general/user/dl525/home/projects/dissertation/LungAirwaySegmentation
cd "$PROJECT"
EXPECTED_RUNNER_BLOB=f4fb55262c0a9bd85ae1a6aedadad1f5326e903a
ACTUAL_RUNNER_BLOB=$(git hash-object scripts/run_nnunet_mt240_paired.sh)
test "$ACTUAL_RUNNER_BLOB" = "$EXPECTED_RUNNER_BLOB" || {
    echo "Refusing paired soft-clDice launch: shared runner changed"
    echo "expected $EXPECTED_RUNNER_BLOB, found $ACTUAL_RUNNER_BLOB"
    exit 1
}
PAIRED_ARM=softcldice_w010 bash scripts/run_nnunet_mt240_paired.sh
